# =====================================================================
# ZEINITY CREATOR STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================

# 1. Supabase PostgreSQL & Storage Credentials (Optional: LocalStorage fallback)
# Create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-migrations

# 2. YouTube Data API v3 (Optional: Curated fallback feeds)
YOUTUBE_API_KEY=

# 3. AI Model Providers (BYOK - Bring Your Own Key)
# System works 100% offline with intelligent heuristic fallback
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# 4. Telegram Bot Ingestion (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# 5. Universal Webhook Ingest Secret (Optional)
ZEINITY_INGEST_SECRET=

# 6. Next.js App Host
NEXT_PUBLIC_APP_URL=http://localhost:3000
